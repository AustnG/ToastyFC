# Copy to .env (never commit your real .env file)

# 1. Google AI Studio / Gemini API key (free tier works great for overnight batch runs)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 2. Private Google Sheets service account JSON (same key used in GitHub Actions, needs Editor access for Approve & Sync)
TOASTY_SPREADSHEET_ID=1194eXv6isWkB-UYZejnki6I3J25FguxVMJZS26PgdeM
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=C:\ToastyFC\secrets\service-account.json

# 3. Local Windows + Synology DS720+ paths
NAS_ROOT=V:\ToastyFC
NVME_SCRATCH=C:\ToastyScratch

# 4. Rendering & overnight pacing
TOASTY_SHORTHAND=TOA
TOASTY_KIT_COLOR=#cabba2
CHUNK_SECONDS=360
CHUNK_OVERLAP_SECONDS=10
PROXY_FPS=2
GEMINI_RPM_DELAY_SECONDS=15
REVIEW_UI_PORT=8765
